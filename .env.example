# Local development defaults
# Copy this file to .env and replace placeholder secrets before non-local use.

# Database
DATABASE_URL=sqlite+aiosqlite:///./sbom_platform.db
DATABASE_ECHO=False
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sbom_platform
DB_USER=postgres
DB_PASSWORD=
DB_SSL_MODE=disable
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10

# Application
APP_NAME=SBOM Platform
APP_VERSION=1.0.0
DEBUG=True
API_URL=http://localhost:8000

# Security
# Do not commit production values. Generate and set these in your secret manager.
SECRET_KEY=
JWT_SECRET=
SESSION_SECRET=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# Optional external integrations
GITHUB_API_KEY=
NVD_API_KEY=
OSS_INDEX_USERNAME=
OSS_INDEX_PASSWORD=

# Features
ENABLE_MFA=False
ENABLE_WEBHOOKS=True
ENABLE_ASYNC_PROCESSING=True
